{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge.local/schemas/bridge-passage-semantic-v1.schema.json",
  "title": "Bridge passage-semantic foundation v1",
  "description": "Canonical wire schema for Bridge Stage 3 data foundation. It does not define AI mapping, automated QA, UI, or export behavior.",
  "oneOf": [
    { "$ref": "#/$defs/TokenLineage" },
    { "$ref": "#/$defs/TokenInstance" },
    { "$ref": "#/$defs/SourceSemanticUnit" },
    { "$ref": "#/$defs/TargetSemanticUnit" },
    { "$ref": "#/$defs/PassageRecord" },
    { "$ref": "#/$defs/EvidenceRecord" },
    { "$ref": "#/$defs/SemanticRelationship" },
    { "$ref": "#/$defs/SemanticCoverageAccount" },
    { "$ref": "#/$defs/LexicalSolution" },
    { "$ref": "#/$defs/LexicalAlignmentGroup" },
    { "$ref": "#/$defs/QaFinding" },
    { "$ref": "#/$defs/CorrectionProposal" },
    { "$ref": "#/$defs/SemanticLocationCandidate" },
    { "$ref": "#/$defs/SemanticLocationRelationship" },
    { "$ref": "#/$defs/SemanticLocationRun" },
    { "$ref": "#/$defs/MeaningAssessment" },
    { "$ref": "#/$defs/MeaningAnalysisRun" },
    { "$ref": "#/$defs/ReviewRecord" }
    ,{ "$ref": "#/$defs/Exportability" }
  ],
  "$defs": {
    "ReviewStatus": {
      "type": "string",
      "enum": ["UNREVIEWED", "AI_PROPOSED", "HUMAN_APPROVED", "HUMAN_REJECTED", "HUMAN_MODIFIED", "NEEDS_DISCUSSION"]
    },
    "LifecycleStatus": {
      "type": "string",
      "enum": ["ACTIVE", "INACTIVE", "STALE", "SUPERSEDED", "QUARANTINED"]
    },
    "QaDisposition": {
      "type": "string",
      "enum": ["UNRESOLVED", "CONFIRMED_TRANSLATION_ERROR", "ACCEPTABLE_TRANSLATION", "FALSE_POSITIVE", "NEEDS_DISCUSSION", "CORRECTED"]
    },
    "TokenSide": { "type": "string", "enum": ["SOURCE", "TARGET"] },
    "TokenLayer": { "type": "string", "enum": ["ORTHOGRAPHIC", "SUBTOKEN", "MORPHEME"] },
    "NullableTokenLayer": {
      "oneOf": [{ "$ref": "#/$defs/TokenLayer" }, { "type": "null" }]
    },
    "TokenKind": { "type": "string", "enum": ["WORD", "CLITIC", "MORPHEME", "PUNCTUATION", "SYMBOL", "UNKNOWN"] },
    "Cardinality": {
      "type": "string",
      "enum": ["ONE_TO_ONE", "ONE_TO_MANY", "MANY_TO_ONE", "MANY_TO_MANY", "SOURCE_TO_NULL", "NULL_TO_TARGET"]
    },
    "SemanticUnitKind": {
      "type": "string",
      "enum": ["LEXICAL", "MORPHOLOGICAL", "NEGATION", "QUANTIFIER", "PARTICIPANT", "REFERENT", "PREDICATE", "SEMANTIC_ROLE", "CLAUSE", "CLAUSE_RELATION", "DISCOURSE_RELATION", "IMPLICIT_GRAMMATICAL", "IDIOM", "CONSTRUCTION", "TEMPORAL", "SPATIAL"]
    },
    "DependencyRelation": { "type": "string", "enum": ["CONTAINS", "DEPENDS_ON", "DERIVED_FROM", "REFINES"] },
    "SemanticRelation": { "type": "string", "enum": ["COREFERS_WITH", "COEXTENSIVE_WITH", "MODIFIES", "NEGATES", "QUANTIFIES", "PARTICIPANT_OF", "ARGUMENT_OF", "SEMANTICALLY_RELATED"] },
    "SemanticUnitProvenance": { "type": "string", "enum": ["CANONICAL_RESOURCE", "DETERMINISTIC_RULE", "LANGUAGE_ANALYZER", "RESOURCE_ENRICHED", "AI_PROPOSED", "HUMAN_DEFINED", "IMPORTED_TC", "IMPORTED_STAGE3", "MIGRATION"] },
    "AuditEligibility": { "type": "string", "enum": ["ELIGIBLE", "CONDITIONAL", "AGGREGATE_ONLY", "EXCLUDED", "REVIEW_ONLY"] },
    "SemanticObligationStrength": { "type": "string", "enum": ["REQUIRED", "CONTEXT_DEPENDENT", "GRAMMATICAL", "DERIVED", "NON_OBLIGATORY", "UNCERTAIN"] },
    "CoverageAccountingRole": { "type": "string", "enum": ["PRIMARY", "COMPONENT", "AGGREGATE", "EVIDENCE_ONLY"] },
    "CoverageDimension": { "type": "string", "enum": ["LEXICAL_CONTENT", "POLARITY", "QUANTITY", "PARTICIPANT", "REFERENT", "PREDICATION", "TEMPORAL_ASPECTUAL", "SPATIAL_RELATION", "CLAUSE_RELATION", "DISCOURSE_RELATION", "OTHER"] },
    "AuditDirection": { "type": "string", "enum": ["SOURCE_COVERAGE", "TARGET_SUPPORT"] },
    "ActorType": { "type": "string", "enum": ["HUMAN", "AI", "SYSTEM", "MIGRATION"] },
    "ResourceValidationStatus": { "type": "string", "enum": ["NOT_CHECKED", "CONSISTENT", "SUPPORTING", "CONFLICTING", "NOT_APPLICABLE"] },
    "EvidenceKind": { "type": "string", "enum": ["SOURCE_TEXT", "TARGET_TEXT", "MORPHOLOGY", "TRANSLATION_NOTE", "TRANSLATION_WORD", "TRANSLATION_WORD_LIST", "VERSIFICATION", "STRUCTURE", "HUMAN_NOTE", "AI_RATIONALE"] },
    "QaFindingKind": { "type": "string", "enum": ["POSSIBLY_MISSING", "MISSING", "POSSIBLY_UNSUPPORTED", "UNSUPPORTED", "RESOURCE_CONFLICT", "NEEDS_PASSAGE_REVIEW", "NEEDS_EXTENDED_PASSAGE_REVIEW"] },
    "PassageStructureKind": { "type": "string", "enum": ["CHAPTER", "VERSE", "VERSE_BRIDGE", "PARAGRAPH", "POETRY", "HEADING", "NOTE", "CROSS_REFERENCE", "INLINE_MARKUP"] },
    "ExportFormat": { "type": "string", "enum": ["BRIDGE", "CLEAN_USFM", "TRANSLATIONCORE_ALIGNED_USFM", "SCRIPTURE_BURRITO"] },
    "ExportabilityLevel": { "type": "string", "enum": ["FULL", "PARTIAL", "NOT_REPRESENTABLE", "TEXT_ONLY"] },
    "ExportReason": { "type": "string", "enum": ["NONE", "CROSS_VERSE", "NULL_ALIGNMENT", "SEMANTIC_ONLY", "PARTIAL_LEXICAL_COVERAGE", "FORMAT_LIMITATION", "TEXT_ONLY_REQUEST"] },
    "LineageRelation": { "type": "string", "enum": ["SAME_LINEAGE", "POSSIBLE_SUCCESSOR", "SPLIT_FROM", "MERGED_FROM", "NO_CORRESPONDENCE"] },
    "Realization": { "type": "string", "enum": ["LEXICALLY_REALIZED", "GRAMMATICALLY_REALIZED", "PRONOMINALIZED", "IMPLICIT", "NOT_LOCATED", "UNCERTAIN"] },
    "RelationshipProperty": { "type": "string", "enum": ["SPLIT", "MERGED", "CROSS_VERSE", "REORDERED", "DISCONTIGUOUS", "EXPLICITATED", "CLAUSE_RESTRUCTURED", "IDIOMATIC_REALIZATION", "VERSIFICATION_DIFFERENCE"] },
    "MeaningStatus": { "type": "string", "enum": ["PRESERVED", "PRESERVED_WITH_RESTRUCTURING", "PARTIAL", "OVERTRANSLATED", "UNDERTRANSLATED", "MEANING_SHIFT", "CONTRADICTED", "UNVERIFIABLE"] },
    "MeaningComponentStatus": { "type": "string", "enum": ["PRESERVED", "PARTIALLY_PRESERVED", "ALTERED", "CONTRADICTED", "TARGET_ADDS_SPECIFICITY", "TARGET_WEAKENS_SPECIFICITY", "NOT_EXPLICIT_BUT_RECOVERABLE", "NOT_DETERMINABLE", "NOT_APPLICABLE"] },
    "MeaningRunStatus": { "type": "string", "enum": ["RUNNING", "COMPLETE", "FAILED"] },
    "MeaningAssessmentReason": { "type": "string", "enum": ["ASSESSED", "NO_LOCATED_REALIZATION", "AMBIGUOUS_LOCATION", "SEARCH_INCOMPLETE", "UNSUPPORTED_ANALYSIS", "LOCATION_REVIEW_REQUIRED"] },
    "MeaningEvidenceKind": { "type": "string", "enum": ["LEXICAL_CONCEPT", "POLARITY", "QUANTITY", "PARTICIPANT", "SEMANTIC_ROLE", "TEMPORAL", "COMPLETION", "MODALITY", "GRAMMATICAL", "CONTEXTUAL", "RESOURCE", "DETERMINISTIC_CONTRADICTION"] },
    "SourceCoverage": { "type": "string", "enum": ["NOT_CHECKED", "COVERED", "COVERED_BY_RESTRUCTURING", "POSSIBLY_MISSING", "MISSING", "UNCERTAIN"] },
    "TargetSupport": { "type": "string", "enum": ["NOT_CHECKED", "SOURCE_SUPPORTED", "CONTEXT_SUPPORTED", "GRAMMATICALLY_REQUIRED", "EXPLICITATION_SUPPORTED", "POSSIBLY_UNSUPPORTED", "UNSUPPORTED", "UNCERTAIN"] },
    "LocationOutcome": { "type": "string", "enum": ["LOCATED", "AMBIGUOUS", "NOT_LOCATED", "SEARCH_INCOMPLETE", "UNSUPPORTED_ANALYSIS"] },
    "LocationRunStatus": { "type": "string", "enum": ["RUNNING", "COMPLETE", "FAILED"] },
    "LocationCalibrationStatus": { "type": "string", "enum": ["CALIBRATED", "UNCALIBRATED_INTERNAL"] },
    "EmbeddingRole": { "type": "string", "enum": ["CANDIDATE_RETRIEVAL_ONLY"] },
    "LocationEvidenceKind": { "type": "string", "enum": ["SEMANTIC_SIMILARITY", "LEXICAL", "CONCEPT", "MORPHOLOGY", "STRUCTURAL_PROXIMITY", "PASSAGE_COHERENCE", "PARTICIPANT", "HUMAN_PRECEDENT", "RESOURCE", "EXACT_SPAN", "CANDIDATE_COMPETITION"] },
    "PolicyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidencePolicyVersion", "calibrationVersion", "auditPolicyVersion"],
      "properties": {
        "confidencePolicyVersion": { "type": "string", "minLength": 1 },
        "calibrationVersion": { "type": "string", "minLength": 1 },
        "auditPolicyVersion": { "type": "string", "minLength": 1 }
      }
    },
    "ConfidenceScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawScore", "calibratedValue", "confidencePolicyVersion", "calibrationVersion"],
      "properties": {
        "rawScore": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "calibratedValue": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidencePolicyVersion": { "type": "string", "minLength": 1 },
        "calibrationVersion": { "type": "string", "minLength": 1 }
      }
    },
    "CharacterSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startCodePoint", "endCodePoint", "startGrapheme", "endGrapheme", "quote", "quoteSha256", "coordinateVersion", "unicodeVersion", "graphemeSegmentationVersion"],
      "properties": {
        "startCodePoint": { "type": "integer", "minimum": 0 },
        "endCodePoint": { "type": "integer", "minimum": 0 },
        "startGrapheme": { "type": "integer", "minimum": 0 },
        "endGrapheme": { "type": "integer", "minimum": 0 },
        "quote": { "type": "string" },
        "quoteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "coordinateVersion": { "const": "unicode-code-point-v1" },
        "unicodeVersion": { "type": "string", "minLength": 1 },
        "graphemeSegmentationVersion": { "type": "string", "minLength": 1 }
      }
    },
    "StateFields": {
      "type": "object",
      "required": ["reviewStatus", "lifecycleStatus", "revision"],
      "properties": {
        "reviewStatus": { "$ref": "#/$defs/ReviewStatus" },
        "lifecycleStatus": { "$ref": "#/$defs/LifecycleStatus" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "TokenLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "side", "projectId", "logicalResourceId", "book", "canonicalReferenceScope", "tokenLayer", "upstreamIdentity", "createdAt", "provenance", "reviewStatus", "lifecycleStatus", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "side": { "$ref": "#/$defs/TokenSide" },
        "projectId": { "type": ["string", "null"] },
        "logicalResourceId": { "type": "string", "minLength": 1 },
        "book": { "type": "string", "minLength": 3 },
        "canonicalReferenceScope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "tokenLayer": { "$ref": "#/$defs/TokenLayer" },
        "upstreamIdentity": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "provenance": { "$ref": "#/$defs/SemanticUnitProvenance" },
        "reviewStatus": { "$ref": "#/$defs/ReviewStatus" },
        "lifecycleStatus": { "$ref": "#/$defs/LifecycleStatus" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "TokenInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lineageId", "side", "projectId", "resourceId", "resourceVersion", "resourceHash", "textRevision", "book", "displayedReference", "canonicalReferences", "index", "occurrence", "occurrences", "span", "rawForm", "normalizedForm", "normalizationProfile", "tokenizationVersion", "tokenLayer", "tokenKind", "parentInstanceId", "instanceFingerprint", "lemma", "strong", "morphology", "morphologicalFeatures"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "lineageId": { "type": "string", "minLength": 1 },
        "side": { "$ref": "#/$defs/TokenSide" },
        "projectId": { "type": ["string", "null"] },
        "resourceId": { "type": "string", "minLength": 1 },
        "resourceVersion": { "type": ["string", "null"] },
        "resourceHash": { "type": "string", "minLength": 1 },
        "textRevision": { "type": ["string", "null"] },
        "book": { "type": "string" },
        "displayedReference": { "type": "string" },
        "canonicalReferences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "occurrence": { "type": "integer", "minimum": 1 },
        "occurrences": { "type": "integer", "minimum": 1 },
        "span": { "oneOf": [{ "$ref": "#/$defs/CharacterSpan" }, { "type": "null" }] },
        "rawForm": { "type": "string" },
        "normalizedForm": { "type": "string" },
        "normalizationProfile": { "type": "string" },
        "tokenizationVersion": { "type": "string" },
        "tokenLayer": { "$ref": "#/$defs/TokenLayer" },
        "tokenKind": { "$ref": "#/$defs/TokenKind" },
        "parentInstanceId": { "type": ["string", "null"] },
        "instanceFingerprint": { "type": "string", "minLength": 1 },
        "lemma": { "type": ["string", "null"] },
        "strong": { "type": ["string", "null"] },
        "morphology": { "type": ["string", "null"] },
        "morphologicalFeatures": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "SemanticUnitBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "side", "projectId", "book", "kind", "displayedReferences", "canonicalReferences", "tokenInstanceIds", "tokenLineageIds", "rawSurface", "normalizedSurface", "semanticFeatures", "unitConfidence", "provenance", "evidenceIds", "resourceValidationIds", "auditEligibility", "semanticObligation", "accountingRole", "auditOwnerUnitId", "coverageDimension", "semanticFingerprint", "policyBinding", "reviewStatus", "lifecycleStatus", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "side": { "$ref": "#/$defs/TokenSide" },
        "projectId": { "type": "string", "minLength": 1 },
        "book": { "type": "string" },
        "kind": { "$ref": "#/$defs/SemanticUnitKind" },
        "displayedReferences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "canonicalReferences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "tokenInstanceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "tokenLineageIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rawSurface": { "type": "string" },
        "normalizedSurface": { "type": "string" },
        "semanticFeatures": { "type": "object", "additionalProperties": { "type": "string" } },
        "unitConfidence": { "$ref": "#/$defs/ConfidenceScore" },
        "provenance": { "$ref": "#/$defs/SemanticUnitProvenance" },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "resourceValidationIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "auditEligibility": { "$ref": "#/$defs/AuditEligibility" },
        "semanticObligation": { "$ref": "#/$defs/SemanticObligationStrength" },
        "accountingRole": { "$ref": "#/$defs/CoverageAccountingRole" },
        "auditOwnerUnitId": { "type": "string" },
        "coverageDimension": { "$ref": "#/$defs/CoverageDimension" },
        "semanticFingerprint": { "type": "string", "minLength": 1 },
        "policyBinding": { "$ref": "#/$defs/PolicyBinding" },
        "reviewStatus": { "$ref": "#/$defs/ReviewStatus" },
        "lifecycleStatus": { "$ref": "#/$defs/LifecycleStatus" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "SourceSemanticUnit": { "allOf": [{ "$ref": "#/$defs/SemanticUnitBase" }, { "properties": { "side": { "const": "SOURCE" } } }] },
    "TargetSemanticUnit": { "allOf": [{ "$ref": "#/$defs/SemanticUnitBase" }, { "properties": { "side": { "const": "TARGET" } } }] },
    "PassageStructureMarker": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "marker", "displayedReference", "startCodePoint", "endCodePoint", "sourceOrder"],
      "properties": {
        "kind": { "$ref": "#/$defs/PassageStructureKind" }, "marker": { "type": "string" },
        "displayedReference": { "type": ["string", "null"] }, "startCodePoint": { "type": ["integer", "null"], "minimum": 0 },
        "endCodePoint": { "type": ["integer", "null"], "minimum": 0 }, "sourceOrder": { "type": "integer", "minimum": 0 }
      }
    },
    "PassageRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "book", "displayedSourceReferences", "displayedTargetReferences", "canonicalReferences", "sourceResourceId", "sourceResourceVersion", "sourceResourceHash", "targetRevision", "targetContentHash", "structureResourceId", "structureResourceVersion", "structureResourceHash", "targetTextByDisplayedReference", "structureMarkers", "policyBinding", "lifecycleStatus", "revision"],
      "properties": {
        "id": { "type": "string" }, "projectId": { "type": "string" }, "book": { "type": "string" },
        "displayedSourceReferences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "displayedTargetReferences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "canonicalReferences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "sourceResourceId": { "type": "string" }, "sourceResourceVersion": { "type": ["string", "null"] },
        "sourceResourceHash": { "type": "string" }, "targetRevision": { "type": "string" }, "targetContentHash": { "type": "string" },
        "structureResourceId": { "type": "string" }, "structureResourceVersion": { "type": ["string", "null"] },
        "structureResourceHash": { "type": "string" },
        "targetTextByDisplayedReference": { "type": "object", "additionalProperties": { "type": "string" } },
        "structureMarkers": { "type": "array", "items": { "$ref": "#/$defs/PassageStructureMarker" } },
        "policyBinding": { "$ref": "#/$defs/PolicyBinding" }, "lifecycleStatus": { "$ref": "#/$defs/LifecycleStatus" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "EvidenceRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "book", "kind", "resourceId", "resourceVersion", "resourceHash", "occurrenceId", "displayedReferences", "canonicalReferences", "content", "contentHash", "validationStatus", "sourceSemanticUnitIds", "targetSemanticUnitIds", "policyBinding", "reviewStatus", "lifecycleStatus", "revision"],
      "properties": {
        "id": { "type": "string" }, "projectId": { "type": "string" }, "book": { "type": "string" },
        "kind": { "$ref": "#/$defs/EvidenceKind" }, "resourceId": { "type": "string" }, "resourceVersion": { "type": ["string", "null"] },
        "resourceHash": { "type": "string" }, "occurrenceId": { "type": ["string", "null"] },
        "displayedReferences": { "type": "array", "items": { "type": "string" } },
        "canonicalReferences": { "type": "array", "items": { "type": "string" } },
        "content": { "type": "string" }, "contentHash": { "type": "string" },
        "validationStatus": { "$ref": "#/$defs/ResourceValidationStatus" },
        "sourceSemanticUnitIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "targetSemanticUnitIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "policyBinding": { "$ref": "#/$defs/PolicyBinding" }, "reviewStatus": { "$ref": "#/$defs/ReviewStatus" },
        "lifecycleStatus": { "$ref": "#/$defs/LifecycleStatus" }, "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "SemanticUnitDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentUnitId", "childUnitId", "relation", "confidence", "provenance", "evidenceIds"],
      "properties": {
        "parentUnitId": { "type": "string" },
        "childUnitId": { "type": "string" },
        "relation": { "$ref": "#/$defs/DependencyRelation" },
        "confidence": { "$ref": "#/$defs/ConfidenceScore" },
        "provenance": { "$ref": "#/$defs/SemanticUnitProvenance" },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "SemanticUnitRelationEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leftUnitId", "rightUnitId", "relation", "confidence", "provenance", "evidenceIds"],
      "properties": {
        "leftUnitId": { "type": "string" },
        "rightUnitId": { "type": "string" },
        "relation": { "$ref": "#/$defs/SemanticRelation" },
        "confidence": { "$ref": "#/$defs/ConfidenceScore" },
        "provenance": { "$ref": "#/$defs/SemanticUnitProvenance" },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "SemanticRelationship": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "book", "sourceSemanticUnitIds", "targetSemanticUnitIds", "lexicalGroupIds", "realization", "properties", "locationConfidence", "meaningStatus", "meaningConfidence", "sourceCoverage", "targetSupport", "evidenceIds", "policyBinding", "reviewStatus", "lifecycleStatus", "revision"],
      "properties": {
        "id": { "type": "string" }, "projectId": { "type": "string" }, "book": { "type": "string" },
        "sourceSemanticUnitIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "targetSemanticUnitIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "lexicalGroupIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "realization": { "$ref": "#/$defs/Realization" },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/RelationshipProperty" }, "uniqueItems": true },
        "locationConfidence": { "$ref": "#/$defs/ConfidenceScore" }, "meaningStatus": { "$ref": "#/$defs/MeaningStatus" },
        "meaningConfidence": { "$ref": "#/$defs/ConfidenceScore" }, "sourceCoverage": { "$ref": "#/$defs/SourceCoverage" },
        "targetSupport": { "$ref": "#/$defs/TargetSupport" }, "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "policyBinding": { "$ref": "#/$defs/PolicyBinding" }, "reviewStatus": { "$ref": "#/$defs/ReviewStatus" },
        "lifecycleStatus": { "$ref": "#/$defs/LifecycleStatus" }, "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "SemanticCoverageAccount": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "passageId", "direction", "auditOwnerUnitId", "memberUnitIds", "coverageDimension", "semanticFingerprint", "coveredByRelationshipIds", "excludedDuplicateUnitIds", "findingId", "policyBinding", "reviewStatus", "lifecycleStatus", "revision"],
      "properties": {
        "id": { "type": "string" }, "projectId": { "type": "string" }, "passageId": { "type": "string" },
        "direction": { "$ref": "#/$defs/AuditDirection" }, "auditOwnerUnitId": { "type": "string" },
        "memberUnitIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "coverageDimension": { "$ref": "#/$defs/CoverageDimension" }, "semanticFingerprint": { "type": "string" },
        "coveredByRelationshipIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "excludedDuplicateUnitIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "findingId": { "type": ["string", "null"] }, "policyBinding": { "$ref": "#/$defs/PolicyBinding" },
        "reviewStatus": { "$ref": "#/$defs/ReviewStatus" }, "lifecycleStatus": { "$ref": "#/$defs/LifecycleStatus" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "LexicalSolution": {
      "type": "object", "additionalProperties": false,
