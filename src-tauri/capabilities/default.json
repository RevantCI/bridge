{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "shell:allow-execute",
    "shell:allow-spawn",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bridge-engine",
          "sidecar": true
        }
      ]
    }
  ]
}
